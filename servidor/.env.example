# Copia este archivo como .env y completa los valores.
# NO subas el archivo .env real a git.

# Secreto para firmar los tokens JWT.
# Genera uno nuevo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Conexion a PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=training_db
DB_PORT=5432